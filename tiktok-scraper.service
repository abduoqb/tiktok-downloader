[Unit]
Description=TikTok Scraper Web Application
After=network.target

[Service]
Type=simple
User=tiktok
Group=tiktok
WorkingDirectory=/home/tiktok/tiktok-scraper
Environment="PATH=/home/tiktok/tiktok-scraper/venv/bin"
ExecStart=/home/tiktok/tiktok-scraper/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 --timeout 300 web_app:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
